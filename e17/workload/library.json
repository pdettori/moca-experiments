      {
        "id": "edit_config",
        "cmd": "cd project && python3 -c \"import os, pathlib, re; p = pathlib.Path('src/pyc/config.py'); s = re.sub(r'(?m)^MAX_ITER = \\\\d+$', 'MAX_ITER = 300', p.read_text(), count=1); t = s.replace('MAX_ITER = 300', 'MAX_ITER = 301', 1); assert 'MAX_ITER = 300' in s and t != s, 'no MAX_ITER line'\ndef put(text): q = p.with_name('.config.py.tmp'); q.write_text(text); os.replace(q, p)\nput(t); compile(p.read_text(), str(p), 'exec'); put(s); print('edited', p)\"",
        "exit": 0,
        "nominal_ms": 300,
        "run_ms": null,
        "cpu_ms": null
