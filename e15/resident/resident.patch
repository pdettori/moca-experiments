diff --git a/remote-worker/internal/vmpool/resident.go b/remote-worker/internal/vmpool/resident.go
new file mode 100644
index 00000000..5edf8344
--- /dev/null
+++ b/remote-worker/internal/vmpool/resident.go
@@ -0,0 +1,416 @@
+package vmpool
+
+// E15 RESIDENT ARM — a rig-only patch (moca-experiments e15/resident/), never part of
+// moca. With E15_RESIDENT=1 a workspace_key keeps the VM its first command acquired
+// and runs every later command on it, one at a time, until the key has been idle for
+// E15_RESIDENT_IDLE_S (0 = never), the guest agent dies, the driver ends the session,
+// or the pool closes. With E15_RESIDENT unset none of this code runs.
+//
+// What is the SAME as stock, on purpose (SPEC §6.4): acquire (standby pop or cold
+// restore, admission, budget charge), Resume, Run over a fresh vsock connection, the
+// per-key execGate, the timeout bound and its classification. What differs is only the
+// VM's lifetime: the charge taken at acquire (rp.inFlight++) is held while the VM is
+// resident and released when it is destroyed, never per Exec.
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"log"
+	"os"
+	"strconv"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+// ResidentEndSession is the in-band "the driver ended this session" command: an Exec
+// whose Command is exactly this string destroys the key's resident VM (if any) and
+// returns exit 0 without running anything. Resident mode only. It is a valid shell
+// no-op, so a stock worker that receives it runs `:` and exits 0 — but it still costs
+// that worker one VM, so a driver sends it to resident arms only.
+const ResidentEndSession = ": e15-end-session"
+
+// deadAgentMarker is what internal/guestagent answers every command with once a
+// timeout has killed its parked shell (agent.go, ServeConn).
+const deadAgentMarker = "this agent is dead"
+
+// residentFromEnv reads E15_RESIDENT / E15_RESIDENT_IDLE_S. Unset E15_RESIDENT is
+// stock (on=false, nil error). Anything ambiguous refuses, so a mistyped arm fails at
+// start instead of silently measuring the other one.
+func residentFromEnv(get func(string) string) (on bool, idle time.Duration, err error) {
+	sw, idleS := get("E15_RESIDENT"), get("E15_RESIDENT_IDLE_S")
+	switch sw {
+	case "":
+		if idleS != "" {
+			return false, 0, fmt.Errorf("vmpool: E15_RESIDENT_IDLE_S=%q is set but E15_RESIDENT is not: "+
+				"refusing to run the stock arm with a resident setting", idleS)
+		}
+		return false, 0, nil
+	case "1":
+	default:
+		return false, 0, fmt.Errorf("vmpool: E15_RESIDENT=%q: want \"1\" or unset", sw)
+	}
+	n, perr := strconv.ParseInt(idleS, 10, 64)
+	if idleS == "" || perr != nil || n < 0 {
+		return false, 0, fmt.Errorf("vmpool: E15_RESIDENT=1 needs E15_RESIDENT_IDLE_S as integer seconds "+
+			">= 0 (0 = never idle-destroy), got %q", idleS)
+	}
+	return true, time.Duration(n) * time.Second, nil
+}
+
+// applyResidentEnv folds the environment into cfg before Normalize. Called from New.
+func applyResidentEnv(cfg *Config) error {
+	on, idle, err := residentFromEnv(os.Getenv)
+	if err != nil {
+		return err
+	}
+	if on {
+		cfg.Resident = true
+		cfg.ResidentIdle = idle
+	}
+	return nil
+}
+
+// residentVictim is a resident VM the sweep detached for idle. The sweep took its
+// key's execGate (non-blocking) when it detached it; the gate is released only after
+// the VM is destroyed, so a command queued for that key restores a fresh VM but
+// cannot Resume it — mount the workspace — while the old one still holds it.
+type residentVictim struct {
+	vm   VM
+	gate chan struct{}
+}
+
+// stderrWatch tees a Sink and remembers whether the dead-agent text crossed stderr,
+// across chunk boundaries (a bounded tail is kept, not the stream).
+type stderrWatch struct {
+	out  Sink
+	mu   sync.Mutex
+	tail []byte
+	hit  bool
+}
+
+func (w *stderrWatch) Stdout(b []byte) { w.out.Stdout(b) }
+
+func (w *stderrWatch) Stderr(b []byte) {
+	w.out.Stderr(b)
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if w.hit {
+		return
+	}
+	w.tail = append(w.tail, b...)
+	if bytes.Contains(w.tail, []byte(deadAgentMarker)) {
+		w.hit = true
+		w.tail = nil
+		return
+	}
+	if keep := len(deadAgentMarker) - 1; len(w.tail) > keep {
+		w.tail = append(w.tail[:0], w.tail[len(w.tail)-keep:]...)
+	}
+}
+
+func (w *stderrWatch) dead() bool { w.mu.Lock(); defer w.mu.Unlock(); return w.hit }
+
+// residentDestroy releases a resident (or would-be resident) VM's charge and tears it
+// down synchronously. The caller holds rp.execGate, so the gate opens only after the
+// VM is gone — the stock ordering (destroy before gate release). The charge is
+// released before the teardown, as stock destroy does. No replenishment is scheduled:
+// resident mode never keeps standbys.
+func (p *pool) residentDestroy(key string, rp *runPool, vm VM, reason string) {
+	p.mu.Lock()
+	if rp.resident == vm {
+		rp.resident = nil
+	}
+	if rp.inFlight > 0 {
+		rp.inFlight--
+	}
+	p.mu.Unlock()
+	if reason != "" {
+		p.counters.residentRetired()
+		log.Printf("vmpool: e15 resident retire workspace_key=%q vm=%s reason=%s", key, vmID(vm), reason)
+	}
+	if err := vm.Destroy(); err != nil {
+		p.counters.destroyFailed()
+		log.Printf("vmpool: destroy VM for %q: %v", key, err)
+	}
+}
+
+// execResident is ExecPhased in resident mode. runCtx carries the Exec's timeout
+// (armed by ExecPhased exactly as in stock); ctx is the caller's, for classify.
+//
+// GATE FIRST, THEN ACQUIRE — the one ordering difference from stock, where a VM is
+// acquired and then waits on the gate. Stock can do that because every Exec has its
+// own VM; here an Exec that acquired before taking the gate would restore a second VM
+// for a key that is about to (or already does) hold one, costing a restore and a
+// transient charge the resident arm should not pay. Holding the gate across acquire
+// makes "at most one VM per key" structural: the sweep's idle destroy and a retirement
+// both hold the same gate until the old VM is gone, so a queued command restores a
+// fresh VM only after that. The wait is selectable on runCtx, as in stock, and holds
+// no VM and no charge.
+func (p *pool) execResident(ctx, runCtx context.Context, key string, e Exec, out Sink, ph *Phases,
+	timedOut *atomic.Bool, timeoutS uint32) (Result, error) {
+	cancelled := func() error {
+		if cErr := p.classify(ctx, timedOut, timeoutS); cErr != nil {
+			return cErr
+		}
+		return ErrAborted
+	}
+
+	// Pin the run (busy() is true while pinned) so the sweep cannot delete the entry
+	// whose gate this Exec is about to wait on — otherwise acquire could mint a new
+	// runPool, with another gate, behind it. A brand-new key goes through runLocked's
+	// stock admission (MaxRuns, budget) here, exactly as acquire would have.
+	p.mu.Lock()
+	if p.closed {
+		p.mu.Unlock()
+		return Result{}, ErrClosed
+	}
+	if e.Command == ResidentEndSession && p.runs[key] == nil {
+		p.mu.Unlock()
+		return Result{}, nil // nothing to end; never create a run for it
+	}
+	rp, fresh, err := p.runLocked(key)
+	if err != nil {
+		p.mu.Unlock()
+		return Result{}, p.countRefusal(err)
+	}
+	if fresh {
+		rp.unacquired = true // acquire must still count this key's first restore as first-exec
+	}
+	rp.pinned++
+	p.mu.Unlock()
+	defer func() {
+		p.mu.Lock()
+		rp.pinned--
+		p.mu.Unlock()
+	}()
+
+	select {
+	case rp.execGate <- struct{}{}:
+	case <-runCtx.Done():
+		return Result{}, cancelled()
+	}
+	defer func() { <-rp.execGate }()
+
+	p.mu.Lock()
+	vm := rp.resident
+	closed := p.closed
+	p.mu.Unlock()
+	if closed {
+		// Close skipped this key's resident VM because this Exec held the gate; it is
+		// this Exec's to destroy, or it would outlive the pool.
+		if vm != nil {
+			p.residentDestroy(key, rp, vm, "pool-closed")
+		}
+		return Result{}, ErrClosed
+	}
+
+	if e.Command == ResidentEndSession {
+		return p.endResidentSession(key, rp, vm, ph)
+	}
+
+	if vm != nil {
+		if ph != nil {
+			ph.VMID = vmID(vm)
+		}
+		p.counters.residentReuse()
+		return p.runResident(ctx, runCtx, key, rp, vm, e, out, ph, timedOut, timeoutS)
+	}
+
+	// No resident VM: acquire and resume exactly as stock does.
+	t0 := p.clk.Now()
+	vm, arp, cause, err := p.acquire(runCtx, key)
+	if ph != nil {
+		ph.Acquire = p.clk.Now().Sub(t0)
+		ph.Cold = cause
+	}
+	if err != nil {
+		if cErr := p.classify(ctx, timedOut, timeoutS); cErr != nil {
+			return Result{}, cErr
+		}
+		return Result{}, err
+	}
+	if ph != nil {
+		ph.VMID = vmID(vm)
+	}
+	if arp != rp {
+		// Unreachable while rp is pinned (the sweep skips busy runs and Reclaim keeps
+		// them). Checked anyway: running under the wrong gate is the one-mount bug.
+		p.residentDestroy(key, arp, vm, "")
+		return Result{}, fmt.Errorf("vmpool: e15 resident: run entry for %q changed under a pinned Exec", key)
+	}
+	if vm.Key() != key {
+		p.residentDestroy(key, rp, vm, "key-mismatch")
+		return Result{}, fmt.Errorf("%w: popped %q for %q", ErrKeyMismatch, vm.Key(), key)
+	}
+	t0 = p.clk.Now()
+	resumeErr := vm.Resume(runCtx)
+	if ph != nil {
+		ph.Resume = p.clk.Now().Sub(t0)
+		if rph, ok := vm.(resumePhaser); ok {
+			ph.VMResume, ph.VsockDial, ph.Mount = rph.ResumePhases()
+		} else {
+			ph.VMResume, ph.VsockDial, ph.Mount = 0, 0, 0
+		}
+	}
+	if resumeErr != nil {
+		p.residentDestroy(key, rp, vm, "resume-error")
+		if cErr := p.classify(ctx, timedOut, timeoutS); cErr != nil {
+			return Result{}, cErr
+		}
+		return Result{}, p.refuse(RefuseSpawn, "resume %q: %v", key, resumeErr)
+	}
+	// Installed BEFORE the run so runResident has one path for a fresh and a reused
+	// VM; it retires the VM if the run leaves it unusable.
+	p.mu.Lock()
+	rp.resident = vm
+	p.mu.Unlock()
+	return p.runResident(ctx, runCtx, key, rp, vm, e, out, ph, timedOut, timeoutS)
+}
+
+// runResident runs one command on the key's resident VM. Caller holds rp.execGate
+// (and a pin on rp) and has set rp.resident = vm. On return the VM is either still resident (charge
+// held, lastExec = now) or retired and destroyed (charge released) — never both,
+// never neither.
+func (p *pool) runResident(ctx, runCtx context.Context, key string, rp *runPool, vm VM, e Exec, out Sink,
+	ph *Phases, timedOut *atomic.Bool, timeoutS uint32) (Result, error) {
+	w := &stderrWatch{out: out}
+	t0 := p.clk.Now()
+	res, runErr := vm.Run(runCtx, Command{
+		Command:   e.Command,
+		Stdin:     e.Stdin,
+		TimeoutS:  timeoutS,
+		Streaming: e.Streaming,
+		CapBytes:  OutputCapBytes,
+	}, w)
+	if ph != nil {
+		ph.Run = p.clk.Now().Sub(t0)
+	}
+	cErr := p.classify(ctx, timedOut, timeoutS)
+
+	reason := ""
+	switch {
+	case timedOut.Load():
+		reason = "timeout" // the guest killed its parked shell; the agent is dead
+	case runErr != nil:
+		reason = "run-error"
+	case w.dead():
+		reason = "dead-agent"
+	}
+	p.mu.Lock()
+	if reason == "" && p.closed {
+		reason = "pool-closed"
+	}
+	if reason == "" {
+		rp.lastExec = p.clk.Now() // idle counts from the command's END (Review Focus 5)
+		p.mu.Unlock()
+	} else {
+		p.mu.Unlock()
+		t1 := p.clk.Now()
+		p.residentDestroy(key, rp, vm, reason)
+		if ph != nil {
+			ph.Destroy = p.clk.Now().Sub(t1)
+		}
+	}
+	if cErr != nil {
+		return res, cErr
+	}
+	return res, runErr
+}
+
+// endResidentSession handles ResidentEndSession: destroy the key's resident VM, if
+// any. Caller holds rp.execGate; it never acquires a VM.
+func (p *pool) endResidentSession(key string, rp *runPool, vm VM, ph *Phases) (Result, error) {
+	if vm == nil {
+		return Result{}, nil
+	}
+	p.mu.Lock()
+	rp.parked = true
+	p.mu.Unlock()
+	if ph != nil {
+		ph.VMID = vmID(vm)
+	}
+	t0 := p.clk.Now()
+	p.residentDestroy(key, rp, vm, "")
+	p.counters.residentEnded()
+	log.Printf("vmpool: e15 resident end-session workspace_key=%q vm=%s", key, vmID(vm))
+	if ph != nil {
+		ph.Destroy = p.clk.Now().Sub(t0)
+	}
+	return Result{}, nil
+}
+
+// sweepResidentLocked is sweepOnce's resident step for one run. It reports whether
+// the run holds a resident VM (the caller then skips the stock steps for it: the run
+// is busy by construction). Caller holds p.mu.
+//
+// Destroy only when the key is idle AND its gate is free (Review Focus 5). The gate
+// is taken here with a non-blocking send and released by doReclaim after the VM is
+// destroyed — so a command that arrives meanwhile restores a fresh VM, and waits on
+// the gate before resuming it, never touching the destroyed one.
+func (p *pool) sweepResidentLocked(rp *runPool, now time.Time, b *reclaimBatch, budget *int) bool {
+	if rp.resident == nil {
+		// A gate held with no resident VM is a VM this sweep (or Close) detached and
+		// has not finished destroying: keep the stock steps — workspace reclaim — off
+		// the run until it is gone. Every other gate holder is pinned, hence busy.
+		return len(rp.execGate) > 0
+	}
+	if p.cfg.ResidentIdle <= 0 || rp.idleFor(now) < p.cfg.ResidentIdle {
+		return true
+	}
+	select {
+	case rp.execGate <- struct{}{}:
+	default:
+		return true // a command holds the gate: not idle, whatever lastExec says
+	}
+	vm := rp.resident
+	rp.resident = nil
+	if rp.inFlight > 0 {
+		rp.inFlight--
+	}
+	rp.parked = true // the next command is a cold wake, counted as ColdParked
+	b.residents = append(b.residents, residentVictim{vm: vm, gate: rp.execGate})
+	*budget--
+	p.counters.residentIdled()
+	log.Printf("vmpool: e15 resident idle-destroy workspace_key=%q vm=%s idle=%s", rp.key, vmID(vm), rp.idleFor(now))
+	return true
+}
+
+// closeResidentsLocked detaches every resident VM whose gate is free, for Close. A
+// resident VM whose gate is held is mid-command; that Exec sees p.closed when its run
+// ends and retires the VM itself. Caller holds p.mu, with p.closed already set.
+func (p *pool) closeResidentsLocked() []residentVictim {
+	var out []residentVictim
+	for _, rp := range p.runs {
+		if rp.resident == nil {
+			continue
+		}
+		select {
+		case rp.execGate <- struct{}{}:
+		default:
+			continue
+		}
+		out = append(out, residentVictim{vm: rp.resident, gate: rp.execGate})
+		rp.resident = nil
+		if rp.inFlight > 0 {
+			rp.inFlight--
+		}
+	}
+	return out
+}
+
+func (p *pool) destroyResidentVictims(vs []residentVictim) error {
+	var firstErr error
+	for _, r := range vs {
+		if err := r.vm.Destroy(); err != nil {
+			p.counters.destroyFailed()
+			log.Printf("vmpool: destroy resident VM %s: %v", vmID(r.vm), err)
+			if firstErr == nil {
+				firstErr = err
+			}
+		}
+		<-r.gate
+	}
+	return firstErr
+}
