node_modules/
__pycache__/
*.pyc
*.log

# Raw per-run experiment output -- EXPERIMENTS.md/METAL-RUNBOOK.md carry the numbers that
# matter; the underlying per-VM JSON/log files are throwaway rig artifacts, not evidence to
# keep in git. (Carried over from the main repo's .gitignore when these scripts moved here.)
experiments/e10-e13-microvm/e12-results/
experiments/e10-e13-microvm/e13-results/
experiments/e10-e13-microvm/e13-control-results/
experiments/e10-e13-microvm/e13-telemetry/
experiments/e10-e13-microvm/.results/
experiments/e10-e13-microvm/.results-*/

# E2 writes each run's measured table here; experiments/e02-e05-harness/RESULTS.md is the committed baseline.
experiments/e02-e05-harness/.results/
.venv/

# Raw per-run traces belong in release archives, not git (docs/CONVENTIONS.md).
# The small fixtures under */testdata/ and the calibration files already tracked stay
# tracked; --force anything new that is genuinely small.
**/results/**/calls.jsonl
**/results/**/calls.jsonl.gz
**/results/**/samples.jsonl
**/results/**/samples.jsonl.gz
**/results/**/sessions.jsonl
**/results/**/driver-cpu.jsonl
**/results/**/worker.log.gz
**/results/**/warmcold.jsonl
!**/testdata/**

# tracelab fetches these from the data-v1/data-v2 releases (scripts/fetch_results.sh)
analysis/tracelab/data/results/
analysis/tracelab/data/corpora/

# The fetched raw rung trees (data-v3 and later) are archive content; never commit them.
**/results/raw/
**/results/**/raw/
