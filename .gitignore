node_modules/
__pycache__/
*.pyc
*.log

# Raw per-run experiment output -- EXPERIMENTS.md/METAL-RUNBOOK.md carry the numbers that
# matter; the underlying per-VM JSON/log files are throwaway rig artifacts, not evidence to
# keep in git. (Carried over from the main repo's .gitignore when these scripts moved here.)
microvm/e12-results/
microvm/e13-results/
microvm/e13-control-results/
microvm/e13-telemetry/
microvm/.results/
microvm/.results-*/

# E2 writes each run's measured table here; experiments/RESULTS.md is the committed baseline.
experiments/.results/
.venv/

# Raw per-run traces belong in release archives, not git (docs/CONVENTIONS.md).
# The small fixtures under */testdata/ and the calibration files already tracked stay
# tracked; --force anything new that is genuinely small.
**/results/**/calls.jsonl
**/results/**/calls.jsonl.gz
**/results/**/samples.jsonl
**/results/**/samples.jsonl.gz
**/results/**/sessions.jsonl
**/results/**/driver-cpu.jsonl
**/results/**/worker.log.gz
**/results/**/warmcold.jsonl
!**/testdata/**
